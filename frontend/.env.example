# Куда фронт ходит за API. По умолчанию /api/v1 — этот путь в деве проксирует vite,
# а в проде отдаёт nginx.
VITE_API_BASE_URL=/api/v1

# Адрес Go-сервиса для дев-прокси.
VITE_API_PROXY_TARGET=http://localhost:8080

# Год итогов. Должен совпадать с годом, который наполняет seed
# (docker-compose.yml, сервис seed: --year=2025).
VITE_RECAP_YEAR=2025
